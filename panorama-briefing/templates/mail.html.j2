{% macro quellen(qs) %}
<div style="font-size:12px;color:#666;line-height:1.5;margin-top:4px;">
{% for q in qs %}
<a href="{{ q.url }}" style="color:#1a5fb4;text-decoration:none;">{{ q.quelle }}</a> · {{ q.zeit }}{% if q.note %} · <i>{{ q.note }}</i>{% endif %}{% if not loop.last %}<br>{% endif %}
{% endfor %}
</div>
{% endmacro %}
{% macro meldung(m) %}
<div style="margin:0 0 16px 0;padding:0 0 14px 0;border-bottom:1px solid #e5e5e5;">
  <div style="font-size:16px;font-weight:bold;line-height:1.3;color:#111;"><span style="color:#d98e04;">{{ m.sterne }}</span> {{ m.schlagzeile }}</div>
  <div style="font-size:14px;line-height:1.45;margin-top:4px;">{{ m.fakten }}</div>
  <div style="font-size:12px;color:#666;margin-top:4px;">{{ m.ort }} · {{ m.zeit }}{% if m.nur_eine_quelle %} · <b style="color:#b3261e;">nur eine Quelle</b>{% endif %}</div>
  {% if m.dreh_idee %}<div style="font-size:13px;line-height:1.4;margin-top:4px;background:#f3f6fb;padding:6px 8px;border-radius:4px;"><b>Dreh-Idee:</b> {{ m.dreh_idee }}</div>{% endif %}
  {{ quellen(m.quellen) }}
</div>
{% endmacro %}
{% macro sektion(titel, gruppen) %}
<h2 style="font-size:18px;margin:28px 0 10px 0;padding-bottom:4px;border-bottom:2px solid #111;">{{ titel }}</h2>
{% for rubrik, ms in gruppen %}
<h3 style="font-size:13px;text-transform:uppercase;letter-spacing:.5px;color:#555;margin:18px 0 8px 0;">{{ rubrik }}</h3>
{% for m in ms %}{{ meldung(m) }}{% endfor %}
{% endfor %}
{% endmacro %}
<!DOCTYPE html>
<html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ subject }}</title></head>
<body style="margin:0;padding:0;background:#f4f4f4;">
<div style="max-width:680px;margin:0 auto;background:#ffffff;padding:16px 18px;font-family:Arial,Helvetica,sans-serif;color:#222;">
  <div style="font-size:22px;font-weight:bold;">Panorama-Briefing</div>
  <div style="font-size:14px;color:#555;">{{ v.datum }} · Stand {{ v.stand }} Uhr · {{ v.n_meldungen }} Meldungen</div>
  {% if v.warnings %}
  <div style="margin-top:12px;padding:8px 10px;background:#fff4e5;border-left:4px solid #d98e04;font-size:13px;">
    <b>Hinweise zur Prüfung</b><br>{% for w in v.warnings %}• {{ w }}<br>{% endfor %}
  </div>
  {% endif %}

  <h2 style="font-size:18px;margin:24px 0 10px 0;padding-bottom:4px;border-bottom:2px solid #111;">1. Top 5 des Tages</h2>
  {% for t in v.top5 %}
  <div style="margin:0 0 16px 0;padding:0 0 14px 0;border-bottom:1px solid #e5e5e5;">
    <div style="font-size:12px;color:#888;">{{ loop.index }} · {{ t.m.rubrik }}</div>
    <div style="font-size:17px;font-weight:bold;line-height:1.3;">{{ t.m.schlagzeile }}</div>
    <div style="font-size:14px;line-height:1.45;margin-top:4px;"><b>Warum es zieht:</b> {{ t.warum }}</div>
    <div style="font-size:14px;line-height:1.45;margin-top:4px;">{{ t.m.fakten }}</div>
    <div style="font-size:12px;color:#666;margin-top:4px;">{{ t.m.ort }} · {{ t.m.zeit }}{% if t.m.nur_eine_quelle %} · <b style="color:#b3261e;">nur eine Quelle</b>{% endif %}</div>
    {{ quellen(t.m.quellen) }}
  </div>
  {% endfor %}

  {{ sektion("2. Deutschland", v.deutschland) }}
  {{ sektion("3. International", v.international) }}

  <h2 style="font-size:18px;margin:28px 0 10px 0;padding-bottom:4px;border-bottom:2px solid #111;">4. Termine / Erwartbares heute</h2>
  {% for t in v.termine %}
  <div style="margin:0 0 12px 0;font-size:14px;line-height:1.45;"><b>{{ t.thema }}</b><br>{{ t.text }}{{ quellen(t.quellen) }}</div>
  {% else %}
  <div style="font-size:14px;color:#666;">Keine Termine gemeldet.</div>
  {% endfor %}

  <h2 style="font-size:18px;margin:28px 0 10px 0;padding-bottom:4px;border-bottom:2px solid #111;">5. Quellen-Check</h2>
  <div style="font-size:12px;color:#555;margin-bottom:6px;">{{ v.n_items }} Meldungen im 20-Stunden-Fenster gesammelt.</div>
  <table style="border-collapse:collapse;font-size:12px;width:100%;">
    <tr style="text-align:left;color:#555;"><th style="padding:3px 6px 3px 0;">Quelle</th><th>Status</th><th style="text-align:right;">im Fenster</th></tr>
    {% for p in v.protocol %}
    <tr style="border-top:1px solid #eee;"><td style="padding:3px 6px 3px 0;">{{ p.quelle }}</td>
      <td style="color:{{ '#1b7f3b' if p.status == 'OK' else '#b3261e' }};">{{ p.status }}{% if p.grund %}: {{ p.grund }}{% endif %}</td>
      <td style="text-align:right;">{{ p.im_fenster }}/{{ p.eintraege }}</td></tr>
    {% endfor %}
  </table>
  <div style="font-size:12px;color:#777;margin-top:8px;">Eigene Portale (web.de, gmx.*) sind als Quelle ausgeschlossen. Meldungen ohne Zeitstempel sind als solche markiert.</div>

  {% if v.nicht_aufgenommen %}
  <h3 style="font-size:13px;text-transform:uppercase;letter-spacing:.5px;color:#555;margin:22px 0 6px 0;">Bewusst nicht aufgenommen</h3>
  <div style="font-size:12px;color:#555;line-height:1.5;">{% for n in v.nicht_aufgenommen %}• <b>{{ n.thema }}</b> – {{ n.grund }}<br>{% endfor %}</div>
  {% endif %}
</div>
</body></html>
